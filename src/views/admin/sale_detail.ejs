<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container">
  <div class="card receipt">
    <div class="receipt-head">
      <img src="/images/Jollibee-logo.webp" alt="Jollibee" class="receipt-logo" />
      <h1>Receipt <%= sale.receipt_no %></h1>
    </div>
    <p class="receipt-meta"><span>Cashier</span> <strong><%= sale.cashier %></strong></p>
    <p class="receipt-meta"><span>Date</span> <strong><%= new Date(sale.created_at).toLocaleString('en-PH') %></strong></p>
    <table class="table">
      <thead><tr><th>Product</th><th>Price</th><th>Qty</th><th>Subtotal</th></tr></thead>
      <tbody>
        <% items.forEach(i => { %>
          <tr>
            <td><%= i.product_name %></td>
            <td><%= peso(i.unit_price) %></td>
            <td><%= i.quantity %></td>
            <td><%= peso(i.subtotal) %></td>
          </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr class="total-row"><td colspan="3">Total</td><td><%= peso(sale.total_amount) %></td></tr>
        <tr><td colspan="3">Amount Paid</td><td><%= peso(sale.amount_paid) %></td></tr>
        <tr><td colspan="3">Change</td><td><%= peso(sale.change_amount) %></td></tr>
      </tfoot>
    </table>
    <div class="receipt-actions">
      <a href="/admin/sales" class="btn btn-secondary">Back to Sales</a>
      <button onclick="window.print()" class="btn btn-primary">Print</button>
    </div>
  </div>
</main>
<%- include('../partials/foot') %>