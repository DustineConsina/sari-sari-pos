<header class="topbar">
  <a href="/" class="topbar-brand">
    <img src="/images/Jollibee-logo.webp" alt="" class="brand-logo" />
    <span>Jollibee</span>
  </a>
  <nav class="topbar-nav">
    <% if (currentUser && currentUser.role === 'admin') { %>
      <a href="/admin/dashboard">Dashboard</a>
      <a href="/admin/products">Products</a>
      <a href="/admin/sales">Sales</a>
      <a href="/admin/inventory-reports">Inventory Reports</a>
      <a href="/admin/users">Users</a>
    <% } else if (currentUser && currentUser.role === 'sales_rep') { %>
      <a href="/pos">Point of Sale</a>
      <a href="/pos/inventory">Inventory</a>
    <% } %>
  </nav>
  <div class="topbar-user">
    <% if (currentUser) { %>
      <span class="user-chip">
        <%= currentUser.fullName %>
        <small><%= currentUser.role === 'admin' ? 'Admin' : 'Cashier' %></small>
      </span>
      <form method="POST" action="/logout" class="inline-form">
        <button type="submit" class="logout-btn">Logout</button>
      </form>
    <% } %>
  </div>
</header>
<% if (flash && flash.success) { %><div class="alert alert-success"><%= flash.success %></div><% } %>
<% if (flash && flash.error) { %><div class="alert alert-error"><%= flash.error %></div><% } %>
<script>
  document.querySelectorAll('.topbar-nav a').forEach(function (a) {
    var path = location.pathname;
    var href = a.getAttribute('href');
    var exact = href === '/pos';
    if (exact ? path === href : path === href || path.indexOf(href + '/') === 0) {
      a.classList.add('active');
    }
  });
</script>